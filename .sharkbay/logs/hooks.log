{"timestamp":"2026-06-22T14:15:29.912Z","source":"cursor","payload":{"conversation_id":"ab1b0873-6001-4ce6-af9f-78691fc439f5","generation_id":"f43ad5e2-8a5c-4b21-9d83-d9547b56a387","model":"composer-2.5-fast","content":"enum MessageRole { system, user, assistant, tool }\n\n/// Base class for all messages exchanged with an LLM.\nabstract class LLMMessage {\n  final MessageRole role;\n  LLMMessage(this.role);\n\n  Map<String, dynamic> toJson();\n\n  static LLMMessage fromJson(Map<String, dynamic> json) {\n    final roleStr = json['role'] as String;\n    final role = MessageRole.values.firstWhere(\n      (e) => e.toString().split('.').last == roleStr,\n    );\n\n    switch (role) {\n      case MessageRole.system:\n        return SystemMessage.fromJson(json);\n      case MessageRole.user:\n        return UserMessage.fromJson(json);\n      case MessageRole.assistant:\n        return ModelMessage.fromJson(json);\n      case MessageRole.tool:\n        return FunctionExecutionResultMessage.fromJson(json);\n    }\n  }\n}\n\nclass SystemMessage extends LLMMessage {\n  final String content;\n  SystemMessage(this.content) : super(MessageRole.system);\n\n  Map<String, dynamic> toJson() => {'role': 'system', 'content': content};\n\n  factory SystemMessage.fromJson(Map<String, dynamic> json) {\n    return SystemMessage(json['content'] as String);\n  }\n}\n\n/// Base class for user content parts\nabstract class UserContentPart {\n  Map<String, dynamic> toJson();\n\n  static UserContentPart fromJson(Map<String, dynamic> json) {\n    final type = json['type'] as String;\n    switch (type) {\n      case 'text':\n        return TextPart.fromJson(json);\n      case 'image':\n        return ImagePart.fromJson(json);\n      case 'video':\n        return VideoPart.fromJson(json);\n      case 'audio':\n        return AudioPart.fromJson(json);\n      case 'document':\n        return DocumentPart.fromJson(json);\n      default:\n        throw Exception('Unknown content part type: $type');\n    }\n  }\n}\n\nabstract class ModelContentPart {\n  Map<String, dynamic> toJson();\n\n  static ModelContentPart fromJson(Map<String, dynamic> json) {\n    final type = json['type'] as String;\n    switch (type) {\n      case 'text':\n        return ModelTextPart.fromJson(json);\n      case...[truncated 764 chars]","file_path":"/Users/laibao/Code/memex_lab/dart_agent_core/lib/src/core/message.dart","attachments":[],"session_id":"ab1b0873-6001-4ce6-af9f-78691fc439f5","hook_event_name":"beforeReadFile","cursor_version":"2026.06.19-20-24-33-653a7fb","workspace_roots":["/Users/laibao/Code/memex_lab/dart_agent_core"],"user_email":"tigerlaibao@gmail.com","transcript_path":"/Users/laibao/.cursor/projects/Users-laibao-Code-memex-lab-dart-agent-core/agent-transcripts/ab1b0873-6001-4ce6-af9f-78691fc439f5/ab1b0873-6001-4ce6-af9f-78691fc439f5.jsonl"},"normalized":{"agent":"cursor","sessionId":"ab1b0873-6001-4ce6-af9f-78691fc439f5","event":"tool_start","timestamp":"2026-06-22T14:15:29.912Z","cwd":"/Users/laibao/Code/memex_lab/dart_agent_core"},"state":"working","action":""}
